# SPDX-License-Identifier: AGPL-3.0-or-later
# Ticket 20: Podman Quadlet unit for low-overhead systemd integration

[Unit]
Description=Canopy Workbench (n8n-rust) Podman Container
Documentation=https://github.com/Catzpro01/n8n-rust-v3.0
After=local-fs.target network-online.target

[Container]
ContainerName=workflowd
Image=ghcr.io/catzpro01/workflowd:latest
User=10001:10001
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
Volume=workflow-data.volume:/var/lib/workflow-rust:Z
PublishPort=8000:8000
Environment=WORKFLOWD_STATE_DIR=/var/lib/workflow-rust WORKFLOWD_LISTEN_ADDR=0.0.0.0:8000
HealthCmd=curl -f http://127.0.0.1:8000/health/ready || exit 1
HealthInterval=10s
HealthTimeout=3s
HealthRetries=3

[Service]
Restart=on-failure
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target default.target
