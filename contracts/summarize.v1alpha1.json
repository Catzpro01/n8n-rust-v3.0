            },
            "output_digest_algorithm": {
              "type": "string",
              "const": "sha256-jcs"
            },
            "output_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "first_ordinal": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_ordinal": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "causal_trace_links": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_merge_output_digest",
                "source_merge_output_segments",
                "retained_ordinal_range",
                "retained_item_provenance"
              ],
              "properties": {
                "source_merge_output_digest": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_merge_output_segments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "artifact_id",
                      "format",
                      "media_type",
                      "logical_bytes",
                      "content_digest_algorithm"
                    ],
                    "properties": {
                      "artifact_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "format": {
                        "type": "string",
                        "minLength": 1
                      },
                      "media_type": {
                        "type": "string",
                        "minLength": 1
                      },
                      "logical_bytes": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "content_digest_algorithm": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "retained_ordinal_range": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "retained_item_provenance": {
                  "type": "string",
                  "const": "artifact-backed-merge-spool"
                }
              }
            }
          }
        }
      }
