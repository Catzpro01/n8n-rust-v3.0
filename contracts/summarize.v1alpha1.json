        }
      }
    ],
    "outputs": [
      {
        "cardinality": "one",
        "id": "summary",
        "multiplicity": "one",
        "required": true,
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "total_count",
            "true_count",
            "false_count",
            "logical_bytes",
            "output_digest_schema",
            "output_digest_algorithm",
            "output_digest",
            "first_ordinal",
            "last_ordinal",
            "causal_trace_links"
          ],
          "properties": {
            "operation": {
              "type": "string",
              "enum": [
                "output_digest"
              ]
            },
            "total_count": {
              "type": "integer",
              "minimum": 0
            },
            "true_count": {
              "type": "integer",
              "minimum": 0
            },
            "false_count": {
              "type": "integer",
              "minimum": 0
            },
            "logical_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "output_digest_schema": {
              "type": "string",
